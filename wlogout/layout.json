[
  {
    "label" : "lock",
    "action" : "/home/rahatut/.local/bin/lock-screen"
  },

  {
    "label" : "logout",
    "action" : "/usr/bin/niri msg action quit --skip-confirmation"
  },

  {
    "label" : "reboot",
    "action" : "/usr/bin/systemctl reboot"
  },

  {
    "label" : "shutdown",
    "action" : "/usr/bin/systemctl poweroff"
  },

  {
    "label" : "suspend",
    "action" : "/usr/bin/systemctl suspend"
  }
]
